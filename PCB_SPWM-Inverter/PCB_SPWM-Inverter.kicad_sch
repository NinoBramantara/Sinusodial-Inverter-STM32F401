	(text "VGS = 12v\nVDS = 12v\nRds = 17.5 mOhm\nID (max) = 160A\nZthJC with 100% Duty Cycle = 1.5 C/W\nZthJC with 50% Duty Cycle = 0.8 C/W\nZthJC with 10% Duty Cycle = 0.19 C/W\n\nturn on delay = 12 ns\nturn off delay = 44 ns (effect dead time)\nPulse time = 800 ns\n\n\n"
		(exclude_from_sim no)
		(at 13.716 187.198 0)
		(effects
